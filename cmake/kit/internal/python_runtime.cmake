# Resolve aliases before inspecting target properties or declaring installation rules.
function(_nom_python_target target result)
    if(NOT TARGET ${target})
        message(FATAL_ERROR "Python packaging requires a CMake target: ${target}")
    endif()
    get_target_property(aliased ${target} ALIASED_TARGET)
    if(aliased)
        set(target ${aliased})
    endif()
    set(${result} ${target} PARENT_SCOPE)
endfunction()

# Imported ELF libraries are copied, not rewritten. Reject binaries that embed paths which
# cannot survive wheel installation. Dependency targets must describe the complete closure.
function(_nom_python_check_imported target)
    find_program(readelf NAMES readelf REQUIRED)
    get_target_property(configurations ${target} IMPORTED_CONFIGURATIONS)
    set(properties IMPORTED_LOCATION)
    foreach(configuration IN LISTS configurations)
        string(TOUPPER "${configuration}" configuration)
        list(APPEND properties "IMPORTED_LOCATION_${configuration}")
    endforeach()
    set(locations)
    foreach(property IN LISTS properties)
        get_target_property(location ${target} ${property})
        if(location)
            list(APPEND locations "${location}")
        endif()
    endforeach()
    list(REMOVE_DUPLICATES locations)
    if(NOT locations)
        message(FATAL_ERROR "Python runtime library ${target} has no imported location")
    endif()
    foreach(location IN LISTS locations)
        execute_process(COMMAND "${readelf}" --dynamic "${location}"
            RESULT_VARIABLE status OUTPUT_VARIABLE dynamic ERROR_VARIABLE error)
        if(NOT status EQUAL 0)
            message(FATAL_ERROR "Cannot inspect Python runtime library ${target}: ${error}")
        endif()
        if(NOT dynamic MATCHES "\\(SONAME\\)[^\n]*\\[([^]/]+)\\]")
            message(FATAL_ERROR "Python runtime library ${target} requires a filename-only ELF SONAME")
        endif()
        string(REGEX MATCHALL "\\((RPATH|RUNPATH)\\)[^\n]*\\[[^]]*\\]" paths "${dynamic}")
        foreach(path IN LISTS paths)
            string(REGEX REPLACE ".*\\[([^]]*)\\]" "\\1" path "${path}")
            if(NOT path STREQUAL "" AND NOT path STREQUAL "$ORIGIN" AND NOT path STREQUAL "\${ORIGIN}")
                message(FATAL_ERROR "Python runtime library ${target} has unsupported runtime path '${path}'; "
                    "rebuild it with $ORIGIN for package-local dependencies")
            endif()
        endforeach()
    endforeach()
endfunction()
