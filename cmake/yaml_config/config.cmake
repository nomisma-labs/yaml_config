include_guard(GLOBAL)

# Absolute build layout constants.
# Collection must match nom_app() in the shared kit. The internal cache makes
# these constants available across directory scopes, including deferred calls.
set(NOM_COLLECTION_CONFIG_DIR "${CMAKE_BINARY_DIR}/config" CACHE INTERNAL "Collected config directory")
set(NOM_GEN_CONFIG_DIR "${CMAKE_BINARY_DIR}/genconfig" CACHE INTERNAL "Generated config directory")
set(NOM_CONFIG_BUILD_DIR "${CMAKE_BINARY_DIR}/CMakeFiles/yaml_config" CACHE INTERNAL "Config build metadata directory")

find_package(Python 3.11 REQUIRED COMPONENTS Interpreter)
get_filename_component(ycfg_tools "${CMAKE_CURRENT_LIST_DIR}/../../tools/yaml_config" ABSOLUTE)
set_property(GLOBAL PROPERTY YCFG_PYTHON "${Python_EXECUTABLE}")
set_property(GLOBAL PROPERTY YCFG_TOOLS "${ycfg_tools}")
set_property(GLOBAL PROPERTY YCFG_PLAN "${NOM_CONFIG_BUILD_DIR}/plan.json")

if(TARGET config OR TARGET clean_config)
    message(FATAL_ERROR "yaml_config needs the target names config and clean_config")
endif()
add_custom_target(config)
add_custom_target(clean_config
    COMMAND ${CMAKE_COMMAND} -E rm -rf
        "${NOM_COLLECTION_CONFIG_DIR}" "${NOM_GEN_CONFIG_DIR}" "${NOM_CONFIG_BUILD_DIR}/records"
    COMMENT "Removing collected configs, generated configs and generation records"
    VERBATIM)
set_property(DIRECTORY "${CMAKE_SOURCE_DIR}" APPEND PROPERTY ADDITIONAL_CLEAN_FILES
    "${NOM_COLLECTION_CONFIG_DIR}" "${NOM_GEN_CONFIG_DIR}" "${NOM_CONFIG_BUILD_DIR}/records")

function(_nom_ycfg_json_string result value)
    string(REPLACE "\\" "\\\\" value "${value}")
    string(REPLACE "\"" "\\\"" value "${value}")
    string(REPLACE "\n" "\\n" value "${value}")
    string(REPLACE "\r" "\\r" value "${value}")
    string(REPLACE "\t" "\\t" value "${value}")
    set(${result} "\"${value}\"" PARENT_SCOPE)
endfunction()

function(_nom_ycfg_json_array result)
    set(items)
    foreach(value IN LISTS ARGN)
        _nom_ycfg_json_string(item "${value}")
        list(APPEND items "${item}")
    endforeach()
    list(JOIN items "," contents)
    set(${result} "[${contents}]" PARENT_SCOPE)
endfunction()

# nom_ycfg_generate(<app> SOURCE <relative-file> [SECTIONS <names...>]
#               [ENVIRONMENT <NAME=value>...] [BUILD_WITH_APP])
# Register after nom_app(). Omit SECTIONS to select all generation-enabled sections.
# Run via config or <project>_generate_ycfg_<app>; BUILD_WITH_APP also attaches it
# to this app. Apps sharing a source must use identical generation settings.
# Does nothing when nom_build_apps is OFF.
function(nom_ycfg_generate app)
    if(NOT nom_build_apps)
        return()
    endif()
    get_property(python GLOBAL PROPERTY YCFG_PYTHON)
    execute_process(COMMAND "${python}" -c "import yaml; assert yaml.__version__ == '6.0.3', yaml.__version__"
        RESULT_VARIABLE dependency_status ERROR_VARIABLE dependency_error)
    if(NOT dependency_status STREQUAL "0")
        message(FATAL_ERROR "YAML generation requires PyYAML 6.0.3 in ${python}. Install tools/yaml_config/requirements.txt. ${dependency_error}")
    endif()
    cmake_parse_arguments(PARSE_ARGV 1 arg "BUILD_WITH_APP" "SOURCE" "SECTIONS;ENVIRONMENT")
    if(DEFINED arg_UNPARSED_ARGUMENTS OR DEFINED arg_KEYWORDS_MISSING_VALUES
       OR NOT DEFINED arg_SOURCE OR arg_SOURCE STREQUAL ""
       OR (DEFINED arg_SECTIONS AND arg_SECTIONS STREQUAL ""))
        message(FATAL_ERROR "nom_ycfg_generate(${app}) requires SOURCE; optional SECTIONS takes section names and ENVIRONMENT takes NAME=value entries")
    endif()
    set(target "${app}")
    if(NOT TARGET "${target}")
        message(FATAL_ERROR "nom_ycfg_generate(${app}): declare the app with nom_app() first")
    endif()
    get_target_property(app_directory "${target}" SOURCE_DIR)
    cmake_path(GET app_directory FILENAME app_folder)
    set(collector "${PROJECT_NAME}_copy_${app_folder}_config")
    if(NOT TARGET "${collector}")
        message(FATAL_ERROR "nom_ycfg_generate(${app}): the app needs an adjacent config directory")
    endif()
    get_target_property(collector_directory "${collector}" SOURCE_DIR)
    if(NOT collector_directory STREQUAL app_directory)
        message(FATAL_ERROR "nom_ycfg_generate(${app}): app directory basename '${app_folder}' is already collected from ${collector_directory}")
    endif()
    set(source_directory "${app_directory}/config")
    if(IS_ABSOLUTE "${arg_SOURCE}" OR arg_SOURCE MATCHES "(^|/)\\.\\.(/|$)|[;\n\r]")
        message(FATAL_ERROR "nom_ycfg_generate(${app}): SOURCE must be a relative file within the app config directory")
    endif()
    set(original_source "${source_directory}/${arg_SOURCE}")
    cmake_path(NORMAL_PATH original_source)
    if(NOT EXISTS "${original_source}" OR IS_DIRECTORY "${original_source}")
        message(FATAL_ERROR "nom_ycfg_generate(${app}): source file not found: ${original_source}")
    endif()
    set(collected_source "${NOM_COLLECTION_CONFIG_DIR}/${app_folder}/${arg_SOURCE}")
    cmake_path(NORMAL_PATH collected_source)
    string(SHA256 group_id "${collected_source}")

    list(REMOVE_DUPLICATES arg_SECTIONS)
    list(SORT arg_SECTIONS)
    set(section_options)
    foreach(section IN LISTS arg_SECTIONS)
        list(APPEND section_options "--config=${section}")
    endforeach()
    get_property(python GLOBAL PROPERTY YCFG_PYTHON)
    get_property(tools GLOBAL PROPERTY YCFG_TOOLS)
    get_property(plan GLOBAL PROPERTY YCFG_PLAN)
    execute_process(COMMAND "${python}" "${tools}/ycfggen.py"
        --source "${original_source}" --list ${section_options}
        RESULT_VARIABLE status OUTPUT_VARIABLE metadata ERROR_VARIABLE diagnostic)
    if(NOT status STREQUAL "0")
        message(FATAL_ERROR "nom_ycfg_generate(${app}): ${diagnostic}")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
        "${original_source}" "${tools}/ycfggen.py" "${tools}/ycfg.py" "${tools}/yaml_codec.py")

    set(environment "{}")
    foreach(assignment IN LISTS arg_ENVIRONMENT)
        if(NOT assignment MATCHES "^([A-Za-z_][A-Za-z_0-9]*)=(.*)$")
            message(FATAL_ERROR "nom_ycfg_generate(${app}): ENVIRONMENT requires NAME=value: ${assignment}")
        endif()
        set(key "${CMAKE_MATCH_1}")
        _nom_ycfg_json_string(value "${CMAKE_MATCH_2}")
        string(JSON environment SET "${environment}" "${key}" "${value}")
    endforeach()

    set(outputs "[]")
    set(output_files)
    set(selected_sections)
    string(JSON count LENGTH "${metadata}")
    math(EXPR last "${count} - 1")
    foreach(index RANGE 0 ${last})
        string(JSON section GET "${metadata}" ${index} section)
        string(JSON filename GET "${metadata}" ${index} gen_file)
        string(JSON generate GET "${metadata}" ${index} generate)
        if(NOT generate)
            if(DEFINED arg_SECTIONS)
                message(FATAL_ERROR "nom_ycfg_generate(${app}): section '${section}' has generate=false")
            endif()
            continue()
        endif()
        if(section MATCHES "[;\n\r]" OR filename MATCHES "[;\n\r]")
            message(FATAL_ERROR "nom_ycfg_generate(${app}): section and output names cannot contain semicolons or newlines in CMake")
        endif()
        set(relative_output "${section}/${filename}")
        cmake_path(NORMAL_PATH relative_output)
        _nom_ycfg_json_string(section_json "${section}")
        _nom_ycfg_json_string(path_json "${relative_output}")
        string(JSON output_index LENGTH "${outputs}")
        string(JSON outputs SET "${outputs}" ${output_index}
            "{\"section\":${section_json},\"path\":${path_json}}")
        list(APPEND output_files "${NOM_GEN_CONFIG_DIR}/${relative_output}")
        list(APPEND selected_sections "${section}")
    endforeach()
    list(SORT selected_sections)
    _nom_ycfg_json_array(sections_json ${selected_sections})
    _nom_ycfg_json_string(source_json "${collected_source}")
    set(registration "{\"id\":\"${group_id}\",\"source\":${source_json},\"sections\":${sections_json},\"environment\":${environment},\"outputs\":${outputs}}")
    get_property(previous GLOBAL PROPERTY "YCFG_GROUP_${group_id}")
    if(previous AND NOT previous STREQUAL registration)
        message(FATAL_ERROR "nom_ycfg_generate(${app}): conflicting registrations for ${collected_source}")
    endif()
    get_target_property(app_group "${target}" YCFG_GROUP)
    if(app_group AND NOT app_group STREQUAL group_id)
        message(FATAL_ERROR "nom_ycfg_generate(${app}): an app can register only one config source")
    endif()
    set_property(TARGET "${target}" PROPERTY YCFG_GROUP "${group_id}")

    set(generation_target "yaml_config_generate_${group_id}")
    if(NOT previous)
        set_property(GLOBAL PROPERTY "YCFG_GROUP_${group_id}" "${registration}")
        set_property(GLOBAL APPEND PROPERTY YCFG_GROUPS "${group_id}")
        set(invalidate_target "yaml_config_invalidate_${group_id}")
        add_custom_target(${invalidate_target}
            COMMAND "${python}" "${tools}/ycfg_build.py" invalidate --plan "${plan}" --group "${group_id}"
            VERBATIM)
        add_dependencies(${collector} ${invalidate_target})
        add_custom_target(${generation_target}
            COMMAND "${python}" "${tools}/ycfg_build.py" generate --plan "${plan}" --group "${group_id}"
            BYPRODUCTS ${output_files}
            COMMENT "Generating configs from ${app_folder}/${arg_SOURCE}"
            VERBATIM)
        add_dependencies(${generation_target} ${collector})
        add_dependencies(config ${generation_target})
    endif()
    set(app_generation_target "${PROJECT_NAME}_generate_ycfg_${app}")
    if(TARGET "${app_generation_target}")
        get_target_property(existing_group "${app_generation_target}" YCFG_GENERATION_GROUP)
        if(NOT existing_group STREQUAL group_id)
            message(FATAL_ERROR "nom_ycfg_generate(${app}): target ${app_generation_target} already exists")
        endif()
    else()
        add_custom_target(${app_generation_target})
        set_property(TARGET "${app_generation_target}" PROPERTY YCFG_GENERATION_GROUP "${group_id}")
        add_dependencies(${app_generation_target} ${generation_target})
    endif()
    if(arg_BUILD_WITH_APP)
        add_dependencies(${target} ${app_generation_target})
    endif()

    get_target_property(excluded "${target}" EXCLUDE_FROM_ALL)
    get_property(installed GLOBAL PROPERTY "YCFG_INSTALL_${group_id}")
    if(nom_install AND NOT excluded AND NOT installed)
        # Check the complete group's record before installing any of its outputs.
        set(install_check "execute_process(COMMAND [==[${python}]==] [==[${tools}/ycfg_build.py]==] verify --plan [==[${plan}]==] --group [==[${group_id}]==] RESULT_VARIABLE status ERROR_VARIABLE diagnostic)\nif(NOT status STREQUAL \"0\")\n  message(FATAL_ERROR \"Config installation failed: \${diagnostic}\")\nendif()")
        install(CODE "${install_check}")
        # Preserve the build-relative config layout under the installation prefix.
        foreach(output IN LISTS output_files)
            file(RELATIVE_PATH relative_output "${CMAKE_BINARY_DIR}" "${output}")
            cmake_path(GET relative_output PARENT_PATH destination)
            install(FILES "${output}" DESTINATION "${destination}")
        endforeach()
        set_property(GLOBAL PROPERTY "YCFG_INSTALL_${group_id}" TRUE)
    endif()
endfunction()

# nom_ycfg_test(<app> <section>) opts one generated config into CTest.
# Requires nom_build_tests and nom_build_apps; otherwise no test is registered.
function(nom_ycfg_test app section)
    if(NOT nom_build_tests OR NOT nom_build_apps)
        return()
    endif()
    set(target "${app}")
    if(NOT TARGET "${target}")
        message(FATAL_ERROR "nom_ycfg_test(${app}): no such app")
    endif()
    get_target_property(group_id "${target}" YCFG_GROUP)
    if(NOT group_id)
        message(FATAL_ERROR "nom_ycfg_test(${app}): call nom_ycfg_generate() first")
    endif()
    get_property(registration GLOBAL PROPERTY "YCFG_GROUP_${group_id}")
    string(JSON count LENGTH "${registration}" outputs)
    set(index 0)
    while(index LESS count)
        string(JSON name GET "${registration}" outputs ${index} section)
        if(name STREQUAL section)
            string(JSON path GET "${registration}" outputs ${index} path)
            add_test(NAME "${PROJECT_NAME}_${app}_config_${section}"
                COMMAND $<TARGET_FILE:${target}> --config "${NOM_GEN_CONFIG_DIR}/${path}" --check-config)
            set_tests_properties("${PROJECT_NAME}_${app}_config_${section}" PROPERTIES LABELS config)
            return()
        endif()
        math(EXPR index "${index} + 1")
    endwhile()
    message(FATAL_ERROR "nom_ycfg_test(${app}): section '${section}' is not registered for generation")
endfunction()

# Match the kit's collector naming convention without interpreting folder names as regexes.
function(_nom_ycfg_matches_collector_name result target folder)
    set(expected_suffix "_copy_${folder}_config")
    string(LENGTH "${target}" target_length)
    string(LENGTH "${expected_suffix}" suffix_length)
    math(EXPR suffix_start "${target_length} - ${suffix_length}")
    set(matches FALSE)
    if(NOT suffix_start LESS 0)
        string(SUBSTRING "${target}" ${suffix_start} -1 actual_suffix)
        if(actual_suffix STREQUAL expected_suffix)
            set(matches TRUE)
        endif()
    endif()
    set(${result} "${matches}" PARENT_SCOPE)
endfunction()

# Adapter for the existing kit collector: discover targets without requiring kit changes.
function(_nom_ycfg_collect_config_targets directory)
    get_property(targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
    foreach(target IN LISTS targets)
        get_target_property(type "${target}" TYPE)
        # The kit reuses a collector name even for distinct directories with the
        # same basename in one project. Inspect app dependencies to catch that case.
        if(type STREQUAL "EXECUTABLE")
            get_target_property(app_directory "${target}" SOURCE_DIR)
            cmake_path(GET app_directory FILENAME app_folder)
            get_target_property(dependencies "${target}" MANUALLY_ADDED_DEPENDENCIES)
            foreach(dependency IN LISTS dependencies)
                _nom_ycfg_matches_collector_name(matches "${dependency}" "${app_folder}")
                if(matches)
                    get_target_property(collector_directory "${dependency}" SOURCE_DIR)
                    if(NOT collector_directory STREQUAL app_directory)
                        message(FATAL_ERROR "App ${target} shares a config directory basename with ${collector_directory}; app directory basenames must be unique")
                    endif()
                endif()
            endforeach()
        endif()
        if(NOT type STREQUAL "UTILITY" OR NOT target MATCHES "_copy_.+_config$")
            continue()
        endif()
        get_property(is_generation_target TARGET "${target}" PROPERTY YCFG_GENERATION_GROUP SET)
        if(is_generation_target)
            continue()
        endif()
        get_target_property(source "${target}" SOURCE_DIR)
        cmake_path(GET source FILENAME folder)
        _nom_ycfg_matches_collector_name(matches "${target}" "${folder}")
        if(NOT matches OR NOT IS_DIRECTORY "${source}/config")
            continue()
        endif()
        string(SHA256 folder_id "${folder}")
        get_property(owner GLOBAL PROPERTY "YCFG_COLLECTOR_${folder_id}")
        if(owner AND NOT owner STREQUAL target)
            message(FATAL_ERROR "Config directory '${folder}' is shared by collectors ${owner} and ${target}; app directory basenames must be unique")
        endif()
        set_property(GLOBAL PROPERTY "YCFG_COLLECTOR_${folder_id}" "${target}")
        add_dependencies(config ${target})
    endforeach()
    get_property(children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
    foreach(child IN LISTS children)
        _nom_ycfg_collect_config_targets("${child}")
    endforeach()
endfunction()

function(_nom_ycfg_finalize_config_plan)
    _nom_ycfg_collect_config_targets("${CMAKE_SOURCE_DIR}")
    get_property(groups GLOBAL PROPERTY YCFG_GROUPS)
    set(contents "")
    set(separator "")
    foreach(group IN LISTS groups)
        get_property(registration GLOBAL PROPERTY "YCFG_GROUP_${group}")
        string(APPEND contents "${separator}${registration}")
        set(separator ",")
    endforeach()
    _nom_ycfg_json_string(input_dir "${NOM_COLLECTION_CONFIG_DIR}")
    _nom_ycfg_json_string(output_dir "${NOM_GEN_CONFIG_DIR}")
    _nom_ycfg_json_string(state_dir "${NOM_CONFIG_BUILD_DIR}/records")
    get_property(plan GLOBAL PROPERTY YCFG_PLAN)
    file(WRITE "${plan}" "{\"input_dir\":${input_dir},\"output_dir\":${output_dir},\"state_dir\":${state_dir},\"groups\":[${contents}]}\n")
    get_property(python GLOBAL PROPERTY YCFG_PYTHON)
    get_property(tools GLOBAL PROPERTY YCFG_TOOLS)
    execute_process(COMMAND "${python}" "${tools}/ycfg_build.py" validate-plan --plan "${plan}"
        RESULT_VARIABLE status ERROR_VARIABLE diagnostic)
    if(NOT status STREQUAL "0")
        message(FATAL_ERROR "Invalid config generation plan: ${diagnostic}")
    endif()
endfunction()

cmake_language(DEFER DIRECTORY "${CMAKE_SOURCE_DIR}" CALL _nom_ycfg_finalize_config_plan)
